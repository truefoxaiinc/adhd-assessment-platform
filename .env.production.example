# Copy this file to .env.production and replace every required placeholder.
# Never commit .env.production or real credentials.

# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
DJANGO_ENV=production
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
JWT_SIGNING_KEY=replace-with-a-different-long-random-secret
ALLOWED_HOSTS=api.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
SECURE_SSL_REDIRECT=True
DATA_UPLOAD_MAX_NUMBER_FIELDS=50000
SWAGGER_DEFAULT_API_URL=https://api.example.com

# -----------------------------------------------------------------------------
# AWS RDS PostgreSQL
# Endpoint only: do not include postgres:// or https://.
# -----------------------------------------------------------------------------
DB_HOST=your-instance.abcdefghijkl.region.rds.amazonaws.com
DB_PORT=5432
DB_NAME=adhd_minder
DB_USER=adhd_minder_app
DATABASE_PASSWORD=iwfjzf0HNkbc4U8sU8Bm
PGSSLMODE=require

# -----------------------------------------------------------------------------
# Redis and Celery
# Compose supplies these defaults. Change only for an external Redis service.
# -----------------------------------------------------------------------------
REDIS_CACHE_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CELERY_CONCURRENCY=2

# -----------------------------------------------------------------------------
# AWS S3 media storage
# Prefer an EC2 IAM role in AWS; leave access keys empty when using a role.
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=replace-with-your-bucket
AWS_S3_REGION_NAME=us-east-1

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
DEFAULT_FROM_EMAIL=noreply@example.com

# -----------------------------------------------------------------------------
# OAuth providers
# -----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_IDS=
APPLE_OAUTH_CLIENT_IDS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=replace-me

# -----------------------------------------------------------------------------
# Firebase
# Mount the credential file into the container before enabling initialization.
# -----------------------------------------------------------------------------
FIREBASE_INITIALIZE=False
FIREBASE_CREDENTIALS_PATH=
GOOGLE_APPLICATION_CREDENTIALS=

# -----------------------------------------------------------------------------
# Google Play subscriptions
# -----------------------------------------------------------------------------
GOOGLE_PLAY_PACKAGE_NAME=com.trufox.attentionminder
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_RTDN_VERIFICATION_TOKEN=

# -----------------------------------------------------------------------------
# Apple subscriptions
# -----------------------------------------------------------------------------
APPLE_BUNDLE_ID=attentionminder.trufoxai.com
APPLE_APP_ID=
APPLE_IAP_PRIVATE_KEY_FILE=
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_APP_ACCOUNT_TOKEN_NAMESPACE=
APPLE_ROOT_CERTIFICATE_FILES=
STORE_REQUIRE_ACCOUNT_ASSOCIATION=False
STORE_ALLOWED_PRODUCT_IDS=attentionminder.monthly,attentionminder.quarterly

# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_SEND_DEFAULT_PII=False
