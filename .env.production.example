# Copy this file to .env.production and replace every required placeholder.
# Never commit .env.production or real credentials.

# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
DJANGO_ENV=production
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
JWT_SIGNING_KEY=replace-with-a-different-long-random-secret
ALLOWED_HOSTS=attention.truefoxaiinc.com
CSRF_TRUSTED_ORIGINS=https://attention.truefoxaiinc.com
CORS_ALLOWED_ORIGINS=https://app.example.com
SECURE_SSL_REDIRECT=True
DATA_UPLOAD_MAX_NUMBER_FIELDS=50000
SWAGGER_DEFAULT_API_URL=https://attention.truefoxaiinc.com

# -----------------------------------------------------------------------------
# AWS RDS PostgreSQL
# Endpoint only: do not include postgres:// or https://.
# -----------------------------------------------------------------------------
DB_HOST=attentionminder-db.cdew4caaqper.eu-north-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DATABASE_PASSWORD=DSi8ZqIDofGOvKZZ47eC
PGSSLMODE=require
POSTGRES_DB=attention_minder
POSTGRES_USER=attention_minder
POSTGRES_PASSWORD=replace-with-the-same-value-as-DATABASE_PASSWORD

# -----------------------------------------------------------------------------
# Redis and Celery
# Compose supplies these defaults. Change only for an external Redis service.
# -----------------------------------------------------------------------------
REDIS_CACHE_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CELERY_CONCURRENCY=2

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
DEFAULT_FROM_EMAIL=noreply@example.com

# -----------------------------------------------------------------------------
# OAuth providers
# -----------------------------------------------------------------------------

GOOGLE_OAUTH_CLIENT_IDS=your_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
APPLE_OAUTH_CLIENT_IDS=your_apple_client_id

# -----------------------------------------------------------------------------
# Firebase
# Mount the credential file into the container before enabling initialization.
# -----------------------------------------------------------------------------
FIREBASE_INITIALIZE=False
FIREBASE_CREDENTIALS_PATH=
GOOGLE_APPLICATION_CREDENTIALS=

# -----------------------------------------------------------------------------
# Google Play subscriptions
# -----------------------------------------------------------------------------

GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=/home/ubuntu/adhd-assessment-platform/secrets/google-play-service-account.json
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=com.trufox.attentionminder
STORE_ALLOWED_PRODUCT_IDS=attentionminder.monthly
STORE_REQUIRE_ACCOUNT_ASSOCIATION=False

# -----------------------------------------------------------------------------
# Apple subscriptions
# -----------------------------------------------------------------------------

APPLE_BUNDLE_ID=attentionminder.trufoxai.com
STORE_REQUIRE_ACCOUNT_ASSOCIATION=False
STORE_ALLOWED_PRODUCT_IDS=attentionminder.monthly,attentionminder.quarterly
APPLE_APP_ID= 6760615839
APPLE_IAP_KEY_ID= 5LPQ5T6BN2
APPLE_IAP_ISSUER_ID= c4be4150-cc99-49bc-887a-62194a524cad
APPLE_APP_ACCOUNT_TOKEN_NAMESPACE= 4DD27EAC-EA04-4028-A3A1-01242982A7E9

# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_SEND_DEFAULT_PII=False
